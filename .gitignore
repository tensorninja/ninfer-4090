# Build
build/
build-*/
cmake-build-*/
*.o
*.obj
*.so
*.a
compile_commands.json
CMakeUserPresets.json
Makefile.local
.cache/
unsloth_compiled_cache/

# CUDA / profiling artifacts
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite

# Python tooling
__pycache__/
*.pyc
.venv/
.venv-*/
venv/
*.egg-info/

# Node test tooling
node_modules/

# Weight artifacts (large; produced by offline tooling)
*.qus
*.bin
*.safetensors
*.gguf
out/
models/
# Anchored: a bare `lora/` would also swallow source directories such as tests/ops/lora/.
/lora/
/lora-archive-*/
vcpkg_installed/
*.log

# Measurement raw corpora & intermediates (large; produced by offline tooling).
# The small final frequency stats under fixtures/ranking/ ARE tracked; the rest is ignored.
tools/freq_corpus/fixtures/*
!tools/freq_corpus/fixtures/ranking/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
profiles/
.chatgpt/
benchmark_results/
benchmark-results/

# Local release products. Keep the publishing guide, upload archives as GitHub Release assets.
dist/*
!dist/README.md

# Claude Code personal/local settings (may contain API tokens)
.claude/settings.local.json

# Screen recordings, masters and transcodes alike. The README embeds them from GitHub's
# user-attachments CDN, which is the only host whose URLs GitHub will render as an inline player,
# so no video needs to be tracked here. Keep the local copies: re-cutting a clip means uploading
# the new MP4 through a GitHub comment box and replacing the URL in README.md.
media/*.mov
media/*.mkv
media/*.mp4
